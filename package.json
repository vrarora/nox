{
  "name": "nox",
  "version": "0.2.0",
  "private": true,
  "description": "A quiet home screen for an LG OLED, sideloaded in Developer Mode.",
  "type": "module",
  "scripts": {
    "dev": "vite",
    "build": "tsc --noEmit && vite build",
    "package": "npm run build && node scripts/package.mjs",
    "tv": "npm run package && node scripts/tv.mjs install launch",
    "measure": "node scripts/measure.mjs"
  },
  "dependencies": {
    "preact": "^10.29.0",
    "qrcode-generator": "^2.0.4"
  },
  "devDependencies": {
    "@fontsource-variable/inter": "^5.3.0",
    "@preact/preset-vite": "^2.10.0",
    "@webos-tools/cli": "^3.2.0",
    "simple-icons": "^16.36.0",
    "typescript": "^5.9.0",
    "vite": "^6.3.0"
  }
}
